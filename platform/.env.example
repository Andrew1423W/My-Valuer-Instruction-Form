# --- Database -------------------------------------------------------------
# Local dev (a Postgres running on your machine):
DATABASE_URL="postgres://vpx@localhost:5432/myvaluer"
# Azure Database for PostgreSQL in production, e.g.
# DATABASE_URL="postgres://user:pass@myvaluer.postgres.database.azure.com:5432/myvaluer?sslmode=require"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Microsoft Entra ID (your existing M365 tenant). Register an app at
# portal.azure.com > Entra ID > App registrations, redirect URI:
#   https://<your-host>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Dev only: skip Entra sign-in and act as this seeded valuer.
# MUST be unset in production.
DEV_USER_EMAIL="andrew@myvaluer.net.nz"

# --- Uploads --------------------------------------------------------------
# Local disk in dev; set an Azure Blob container in production.
UPLOAD_DIR="./uploads"
